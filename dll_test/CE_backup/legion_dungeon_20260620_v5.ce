gf_router_callback:
  dd gf_router_entry
  dd 0
  dd 0
  dd 0

gf_entry_newmem:
  pushfd
  pushad
  call gf_tick
  popad
  popfd
  ret

gf_tick:
  cmp dword ptr [Online.exe+2302C0],0
  jne gf_tick_on
  jmp gf_tick_off

gf_tick_off:
  mov dword ptr [gf_state],0
  mov dword ptr [gf_current_id],0
  mov dword ptr [gf_verify_id],0
  mov dword ptr [gf_verify_index],FFFFFFFF
  mov dword ptr [gf_verify_mode],0
  mov dword ptr [gf_verify_failed_mask],0
  mov dword ptr [gf_wait_battle_result],0
  mov dword ptr [gf_army_battle_confirmed],0
  mov dword ptr [gf_expected_win_value],0
  mov dword ptr [gf_solo_verify_blocked],0
  mov dword ptr [gf_max_solo_index],FFFFFFFF
  mov dword ptr [gf_unlimit_passed_once],0
  mov dword ptr [gf_battle_mode],0
  ret

gf_tick_on:
  call dword ptr [Online.exe+1C43DC]
  mov ebx,eax
  cmp dword ptr [gf_wait_battle_result],1
  je gf_tick_done
  cmp dword ptr [gf_state],0
  je gf_tick_idle
  cmp dword ptr [gf_state],5
  je gf_tick_done
  cmp dword ptr [gf_state],7
  je gf_tick_done

gf_tick_wait:
  sub eax,[gf_wait_tick]
  cmp eax,2710
  jb gf_tick_done
  mov dword ptr [gf_state],0

gf_tick_done:
  ret

gf_tick_idle:
  cmp eax,[gf_next_tick]
  jb gf_tick_done
  call gf_send_4293
  mov dword ptr [gf_state],1
  mov [gf_wait_tick],ebx
  add ebx,0BB8
  mov [gf_next_tick],ebx
  ret

gf_recv_newmem:
gf_router_entry:
  pushfd
  pushad
  mov eax,[gf_router_opcode]
  mov [gf_opcode],eax
  mov eax,[gf_router_payload]
  mov [gf_payload],eax
  mov eax,[gf_router_len]
  mov [gf_len],eax
  call gf_recv_parse
  popad
  popfd
  ret

gf_recv_parse:
  cmp dword ptr [Online.exe+2302C0],0
  je gf_42A4_done
  mov eax,[gf_opcode]
  cmp ax,42A1
  je gf_parse_42A1
  cmp ax,42A2
  je gf_parse_42A2
  cmp ax,42A4
  je gf_parse_42A4
  cmp ax,42A7
  je gf_parse_42A7
  cmp ax,1460
  je gf_parse_5216
  cmp ax,1464
  je gf_parse_5220
  ret

gf_parse_42A1:
  cmp dword ptr [gf_state],1
  jne gf_42A4_done
  mov esi,[gf_payload]
  mov ecx,[gf_len]
  cmp ecx,0D
  jb gf_42A4_done
  lea edi,[esi+ecx-4]
  xor ebx,ebx

gf_42A1_precheck_loop:
  cmp esi,edi
  ja gf_42A1_precheck_ok
  cmp dword ptr [esi],7D7B0200
  je gf_42A1_precheck_match

gf_42A1_precheck_next:
  inc esi
  jmp gf_42A1_precheck_loop

gf_42A1_precheck_match:
  cmp ebx,9
  jae gf_42A1_precheck_ok
  cmp ebx,8
  jne gf_42A1_precheck_status
  cmp dword ptr [esi+4],0
  jne gf_42A1_status08_block

gf_42A1_precheck_status:
  cmp byte ptr [esi-9],08
  je gf_42A1_08
  inc ebx
  inc esi
  jmp gf_42A1_precheck_loop

gf_42A1_precheck_ok:
  mov esi,[gf_payload]
  mov ecx,[gf_len]
  lea edi,[esi+ecx-4]
  xor ebx,ebx

gf_42A1_loop:
  cmp esi,edi
  ja gf_42A1_done
  cmp dword ptr [esi],7D7B0200
  je gf_42A1_match

gf_42A1_next:
  inc esi
  jmp gf_42A1_loop

gf_42A1_match:
  cmp ebx,9
  jae gf_42A1_done
  mov al,[esi-9]
  cmp al,06
  je gf_42A1_06
  cmp al,07
  je gf_42A1_stop
  cmp al,08
  je gf_42A1_08
  cmp al,03
  je gf_42A1_03
  cmp al,04
  je gf_42A1_04
  cmp al,05
  je gf_42A1_05
  cmp al,02
  je gf_42A1_02
  cmp al,01
  je gf_42A1_01

gf_42A1_skip:
  inc ebx
  inc esi
  jmp gf_42A1_loop

gf_42A1_06:
  mov [gf_log_index],ebx
  mov ecx,ebx
  call gf_get_id
  mov [gf_pending_id],eax
  cmp ax,word ptr [gf_verify_id]
  jne gf_42A1_06_check
  cmp dword ptr [gf_wait_battle_result],1
  je gf_42A1_skip
  cmp dword ptr [gf_verify_mode],1
  je gf_42A1_skip
  call gf_update_max_solo
  jmp gf_42A1_skip

gf_42A1_06_check:
  cmp dword ptr [gf_wait_battle_result],1
  je gf_42A1_skip
  cmp dword ptr [gf_solo_verify_blocked],1
  je gf_42A1_skip
  mov ecx,[gf_log_index]
  mov eax,1
  shl eax,cl
  test dword ptr [gf_verify_failed_mask],eax
  jne gf_42A1_skip
  mov eax,[gf_log_index]
  cmp eax,[gf_max_solo_index]
  jle gf_42A1_skip
  mov dword ptr [gf_verify_mode],1
  call gf_start_solo
  ret

gf_42A1_03:
  mov [gf_log_index],ebx
  mov ecx,ebx
  call gf_get_id
  mov [gf_pending_id],eax
  cmp dword ptr [gf_wait_battle_result],1
  je gf_42A1_skip
  cmp dword ptr [gf_solo_verify_blocked],1
  je gf_42A1_03_team
  mov ecx,[gf_log_index]
  mov edx,1
  shl edx,cl
  test dword ptr [gf_verify_failed_mask],edx
  jne gf_42A1_skip
  cmp ax,word ptr [gf_current_id]
  je gf_42A1_03_same
  mov dword ptr [gf_verify_mode],1
  call gf_start_solo
  ret

gf_42A1_03_team:
  mov word ptr [gf_current_id],ax
  call gf_send_4294
  mov dword ptr [gf_state],3
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
  ret

gf_42A1_03_same:
  cmp dword ptr [gf_wait_battle_result],1
  je gf_42A1_skip
  cmp dword ptr [gf_verify_mode],1
  je gf_42A1_skip
  call gf_send_4294
  mov dword ptr [gf_state],3
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
  ret

gf_42A1_04:
  mov [gf_log_index],ebx
  mov ecx,ebx
  call gf_get_id
  mov [gf_pending_id],eax
  call gf_send_4294
  mov dword ptr [gf_state],2
  mov dword ptr [gf_team_order_sent],0
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
  ret

gf_42A1_05:
  mov [gf_log_index],ebx
  mov ecx,ebx
  call gf_get_id
  mov [gf_pending_id],eax
  cmp ax,word ptr [gf_verify_id]
  jne gf_42A1_05_reward
  call gf_update_max_solo

gf_42A1_05_reward:
  mov dword ptr [gf_battle_mode],0
  call gf_send_429F
  mov ecx,[gf_log_index]
  mov eax,[log_reward_table+ecx*4]
  call gf_log
  jmp gf_finish

gf_42A1_01:
  cmp dword ptr [gf_unlimit_passed_once],1
  jne gf_42A1_skip
  cmp dword ptr [gf_max_solo_index],0
  jl gf_42A1_stop
  call gf_send_4294
  mov dword ptr [gf_state],4
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
  ret

gf_42A1_02:
  cmp dword ptr [gf_unlimit_passed_once],1
  je gf_42A1_01
  jmp gf_42A1_done

gf_42A1_08:
  cmp dword ptr [gf_battle_mode],2
  je gf_42A1_stop
  cmp dword ptr [gf_battle_mode],3
  je gf_42A1_stop
  mov [gf_log_index],ebx
  mov ecx,ebx
  call gf_get_id
  mov [gf_pending_id],eax
  mov word ptr [gf_current_id],ax
  mov word ptr [gf_verify_id],ax
  mov [gf_verify_index],ebx
  mov dword ptr [gf_verify_mode],1
  mov dword ptr [gf_wait_battle_result],1
  mov dword ptr [gf_army_battle_confirmed],1
  mov dword ptr [gf_expected_win_value],0
  mov dword ptr [gf_battle_mode],1
  mov dword ptr [gf_state],5
  call gf_send_37A4
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
  ret

gf_42A1_stop:
  jmp gf_finish

gf_42A1_status08_block:
  jmp gf_finish

gf_42A1_done:
  cmp dword ptr [gf_unlimit_passed_once],1
  je gf_finish
  call gf_send_42A6
  mov dword ptr [gf_state],6
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
  ret

gf_parse_42A2:
  cmp dword ptr [gf_state],2
  jne gf_42A2_done
  mov esi,[gf_payload]
  mov eax,[gf_len]
  cmp eax,1A
  jb gf_42A2_done
  lea edi,[esi+eax]
  add esi,04
  call gf_skip_utf
  test eax,eax
  je gf_42A2_done
  lea eax,[esi+06]
  cmp eax,edi
  ja gf_42A2_done
  add esi,04
  movzx eax,byte ptr [esi]
  shl eax,08
  movzx edx,byte ptr [esi+1]
  add eax,edx
  add esi,02
  cmp eax,03
  jne gf_42A2_done
  xor ebx,ebx

gf_42A2_member_loop:
  cmp ebx,03
  jae gf_42A2_member_done
  lea eax,[esi+02]
  cmp eax,edi
  ja gf_42A2_done
  mov [gf_member_ptrs+ebx*4],esi
  movzx eax,byte ptr [esi]
  shl eax,08
  movzx edx,byte ptr [esi+1]
  add eax,edx
  add eax,02
  mov [gf_member_lens+ebx*4],eax
  add esi,eax
  cmp esi,edi
  ja gf_42A2_done
  call gf_skip_utf
  test eax,eax
  je gf_42A2_done
  lea eax,[esi+0C]
  cmp eax,edi
  ja gf_42A2_done
  add esi,0C
  call gf_skip_utf
  test eax,eax
  je gf_42A2_done
  inc ebx
  jmp gf_42A2_member_loop

gf_42A2_member_done:
  cmp dword ptr [gf_team_order_sent],1
  je gf_42A2_full
  call gf_send_429A
  mov dword ptr [gf_team_order_sent],1
  ret

gf_42A2_full:
  mov dword ptr [gf_battle_mode],3
  call gf_send_429E_group
  mov ecx,[gf_log_index]
  mov eax,[log_group_table+ecx*4]
  call gf_log
  jmp gf_finish

gf_42A2_done:
  ret

gf_parse_42A7:
  cmp dword ptr [gf_state],6
  jne gf_42A7_done
  mov esi,[gf_payload]
  mov eax,[gf_len]
  cmp eax,02
  jb gf_42A7_done
  lea edi,[esi+eax]
  movzx eax,byte ptr [esi]
  shl eax,08
  movzx edx,byte ptr [esi+1]
  add eax,edx
  mov [gf_unlimit_count],eax
  add esi,02
  xor ebx,ebx

gf_42A7_loop:
  cmp ebx,[gf_unlimit_count]
  jae gf_42A7_done
  lea eax,[esi+04]
  cmp eax,edi
  ja gf_42A7_done
  mov eax,[esi]
  mov [gf_unlimit_id],eax
  add esi,04
  call gf_skip_utf
  test eax,eax
  je gf_42A7_done
  lea eax,[esi+10]
  cmp eax,edi
  ja gf_42A7_done
  add esi,04
  cmp dword ptr [esi],04000000
  je gf_42A7_battle
  add esi,0C
  call gf_skip_utf
  test eax,eax
  je gf_42A7_done

gf_42A7_next:
  inc ebx
  jmp gf_42A7_loop

gf_42A7_battle:
  mov dword ptr [gf_battle_mode],2
  call gf_send_42A8
  mov eax,log_unlimit
  call gf_log
  mov dword ptr [gf_state],7
  mov dword ptr [gf_army_battle_confirmed],0
  mov dword ptr [gf_expected_win_value],0
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
  ret

gf_42A7_done:
  ret

gf_parse_42A4:
  cmp dword ptr [gf_state],3
  je gf_team_scan
  cmp dword ptr [gf_state],4
  je gf_team_scan
  ret

gf_team_scan:
  mov dword ptr [gf_team_count],0
  mov dword ptr [gf_people_count],0
  mov esi,[gf_payload]
  movzx eax,byte ptr [esi+1]
  mov [gf_payload_team_count],eax
  test eax,eax
  je gf_42A4_decide
  mov ecx,[gf_len]
  cmp ecx,8
  jb gf_42A4_len_short
  lea edi,[esi+ecx-2]

gf_team_loop:
  cmp esi,edi
  ja gf_people_start
  cmp word ptr [esi],0C00
  je gf_team_match
  inc esi
  jmp gf_team_loop

gf_team_match:
  mov eax,[gf_team_count]
  cmp eax,10
  jae gf_people_start
  mov dx,word ptr [esi-6]
  mov word ptr [gf_team_ids+eax*2],dx
  mov dx,word ptr [esi-2]
  mov word ptr [gf_team_dungeon_ids+eax*2],dx
  inc dword ptr [gf_team_count]
  inc esi
  jmp gf_team_loop

gf_people_start:
  mov esi,[gf_payload]
  mov ecx,[gf_len]
  lea edi,[esi+ecx-4]

gf_people_loop:
  cmp esi,edi
  ja gf_42A4_decide
  cmp dword ptr [esi],7D7B0200
  je gf_people_match
  inc esi
  jmp gf_people_loop

gf_people_match:
  mov eax,[gf_people_count]
  cmp eax,10
  jae gf_42A4_decide
  mov dl,[esi-5]
  mov [gf_team_people+eax],dl
  inc dword ptr [gf_people_count]
  inc esi
  jmp gf_people_loop

gf_42A4_decide:
  cmp dword ptr [gf_state],3
  je gf_need_current
  cmp dword ptr [gf_state],4
  je gf_help
  jmp gf_42A4_done

gf_need_current:
  cmp dword ptr [gf_payload_team_count],0
  je gf_create_team
  xor ecx,ecx

gf_need_loop:
  cmp ecx,[gf_team_count]
  jae gf_create_team
  mov ax,word ptr [gf_current_id]
  cmp word ptr [gf_team_dungeon_ids+ecx*2],ax
  jne gf_need_next
  cmp byte ptr [gf_team_people+ecx],01
  je gf_join_current

gf_need_next:
  inc ecx
  jmp gf_need_loop

gf_create_team:
  mov dword ptr [gf_battle_mode],3
  call gf_send_4297
  mov ecx,[gf_log_index]
  mov eax,[log_create_table+ecx*4]
  call gf_log
  jmp gf_finish

gf_join_current:
  mov dword ptr [gf_battle_mode],3
  mov ax,word ptr [gf_team_ids+ecx*2]
  mov word ptr [gf_team_id],ax
  call gf_send_4296
  call gf_send_4293
  mov eax,log_join
  call gf_log
  jmp gf_finish

gf_help:
  cmp dword ptr [gf_max_solo_index],0
  jl gf_42A4_done
  cmp dword ptr [gf_payload_team_count],0
  jne gf_help_has_team
  jmp gf_42A4_done

gf_help_has_team:
  xor ecx,ecx

gf_help_loop:
  cmp ecx,[gf_team_count]
  jae gf_help_no_match
  mov ax,word ptr [gf_team_dungeon_ids+ecx*2]
  call gf_get_index_by_id
  cmp eax,FFFFFFFF
  je gf_help_loop_next
  cmp eax,[gf_max_solo_index]
  jg gf_help_loop_next
  cmp byte ptr [gf_team_people+ecx],03
  jb gf_join_help

gf_help_loop_next:
  inc ecx
  jmp gf_help_loop

gf_help_no_match:
  jmp gf_42A4_done

gf_join_help:
  mov dword ptr [gf_battle_mode],3
  mov ax,word ptr [gf_team_ids+ecx*2]
  mov word ptr [gf_team_id],ax
  call gf_send_4296
  call gf_send_4293
  mov eax,log_join
  call gf_log
  jmp gf_finish

gf_42A4_len_short:
  jmp gf_42A4_done

gf_42A4_done:
  ret

gf_parse_5216:
  cmp dword ptr [gf_state],5
  je @f
  cmp dword ptr [gf_state],7
  jne gf_5216_done
@@:
  mov esi,[gf_payload]
  mov ecx,[gf_len]
  cmp ecx,0A
  jb gf_5216_done
  lea edi,[esi+ecx-0A]

gf_5216_scan_loop:
  cmp esi,edi
  ja gf_5216_done
  cmp dword ptr [esi],796D7261
  jne @f
  cmp dword ptr [esi+4],64696152
  jne @f
  cmp word ptr [esi+8],4246
  je gf_5216_army_match
@@:
  inc esi
  jmp gf_5216_scan_loop

gf_5216_army_match:
  mov dword ptr [gf_army_battle_confirmed],1
  mov dword ptr [gf_expected_win_value],0
  mov esi,[gf_payload]
  mov ecx,[gf_len]
  cmp ecx,0F
  jb gf_5216_done
  lea edi,[esi+ecx-0F]

gf_5216_char_loop:
  cmp esi,edi
  ja gf_5216_done
  cmp dword ptr [esi],72616863
  jne gf_5216_char_next
  cmp dword ptr [esi+4],61636F4C
  jne gf_5216_char_next
  cmp dword ptr [esi+8],6E6F6974
  jne gf_5216_char_next
  cmp byte ptr [esi+0E],31
  je gf_5216_char_defense
  jmp gf_5216_done

gf_5216_char_defense:
  mov dword ptr [gf_expected_win_value],1
  jmp gf_5216_done

gf_5216_char_next:
  inc esi
  jmp gf_5216_char_loop

gf_5216_done:
  ret

gf_parse_5220:
  cmp dword ptr [gf_state],7
  je gf_5220_unlimit
  cmp dword ptr [gf_state],5
  jne gf_5220_done
  cmp dword ptr [gf_wait_battle_result],1
  jne gf_5220_done
  cmp dword ptr [gf_army_battle_confirmed],1
  jne gf_5220_done
  cmp dword ptr [gf_verify_mode],1
  jne gf_5220_clear
  mov esi,[gf_payload]
  mov al,[esi]
  cmp al,byte ptr [gf_expected_win_value]
  je gf_5220_win
  jmp gf_5220_loss

gf_5220_win:
  call gf_update_max_solo
  jmp gf_5220_clear

gf_5220_loss:
  mov ecx,[gf_verify_index]
  cmp ecx,FFFFFFFF
  je gf_5220_loss_no_index
  mov eax,[log_fail_table+ecx*4]
  call gf_log
  mov ecx,[gf_verify_index]
  mov eax,1
  shl eax,cl
  or dword ptr [gf_verify_failed_mask],eax

gf_5220_loss_no_index:
  mov dword ptr [gf_current_id],0
  mov dword ptr [gf_verify_id],0
  mov dword ptr [gf_verify_mode],0
  mov dword ptr [gf_verify_index],FFFFFFFF
  mov dword ptr [gf_solo_verify_blocked],1
  jmp gf_5220_clear

gf_5220_unlimit:
  cmp dword ptr [gf_army_battle_confirmed],1
  jne gf_5220_done
  mov esi,[gf_payload]
  mov al,[esi]
  cmp al,byte ptr [gf_expected_win_value]
  je gf_5220_unlimit_win
  jmp gf_5220_clear

gf_5220_unlimit_win:
  mov dword ptr [gf_unlimit_passed_once],1

gf_5220_clear:
  mov dword ptr [gf_wait_battle_result],0
  mov dword ptr [gf_army_battle_confirmed],0
  mov dword ptr [gf_expected_win_value],0
  mov dword ptr [gf_battle_mode],0
  mov dword ptr [gf_state],0
  call dword ptr [Online.exe+1C43DC]
  add eax,0BB8
  mov [gf_next_tick],eax

gf_5220_done:
  ret

gf_finish:
  mov dword ptr [gf_state],0
  call dword ptr [Online.exe+1C43DC]
  add eax,0BB8
  mov [gf_next_tick],eax
  ret

gf_start_solo:
  mov dword ptr [gf_battle_mode],1
  call gf_send_4297
  call gf_send_429E
  call gf_send_37A4
  mov ax,word ptr [gf_pending_id]
  mov word ptr [gf_current_id],ax
  mov word ptr [gf_verify_id],ax
  cmp dword ptr [gf_verify_mode],1
  jne @f
  mov eax,[gf_log_index]
  mov [gf_verify_index],eax
  mov dword ptr [gf_wait_battle_result],1
  mov dword ptr [gf_army_battle_confirmed],0
  mov dword ptr [gf_expected_win_value],0
  mov dword ptr [gf_state],5
  call dword ptr [Online.exe+1C43DC]
  mov [gf_wait_tick],eax
@@:
  mov eax,[gf_log_index]
  mov ecx,eax
  mov eax,[log_single_table+ecx*4]
  call gf_log
  ret

gf_update_max_solo:
  mov dword ptr [gf_verify_id],0
  mov dword ptr [gf_current_id],0
  mov dword ptr [gf_verify_mode],0
  mov dword ptr [gf_wait_battle_result],0
  mov dword ptr [gf_army_battle_confirmed],0
  mov eax,[gf_verify_index]
  cmp eax,FFFFFFFF
  je gf_update_max_solo_done
  cmp eax,[gf_max_solo_index]
  jle gf_update_max_solo_done
  mov [gf_max_solo_index],eax
  mov ecx,eax
  mov eax,[log_max_table+ecx*4]
  call gf_log

gf_update_max_solo_done:
  mov dword ptr [gf_verify_index],FFFFFFFF
  ret

gf_get_index_by_id:
  push ecx
  xor ecx,ecx

gf_get_index_by_id_loop:
  cmp ecx,9
