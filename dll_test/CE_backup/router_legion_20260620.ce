daysign_need_sign:
  dd 0
daysign_bonus_bits:
  dd 0
daysign_last_query:
  dd 0

xycj_id:
  dd 0
xycj_count:
  dd 0
xycj_state:
  dd 0
zpdfw_pending:
  dd 0
zpdfw_router_3ea4_hits:
  dd 0
zpdfw_router_switch_seen:
  dd 0
zpdfw_router_pending_sets:
  dd 0
weekly_activity:
  dd 0
weekly_next_data:
  dd 0
weekly_pending_next:
  dd 0
weekly_cmd_send_next:
  dd 0
weekly_last_sent_data:
  dd FFFFFFFF
weekly_recv_len:
  dd 0
weekly_packet_dump:
  db 00 00 00 00
jrnt_ids:
  db FF FF FF 00
jrnt_pending_open:
  dd 0
jrnt_claim_pending:
  db 00 00 00 00
