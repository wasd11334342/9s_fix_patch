  dd 0
// L"周常任務 積分 %i"
router_log_weekly_recv:
  db 68 54 38 5E FB 4E D9 52 20 00 4D 7A 06 52 20 00 25 00 69 00 00 00
shared_dispatch:
  jmp shared_dispatch_hook
dispatch_return:

shared_dispatch_hook:
  pushad

  cmp cx,4F05
  je handle_daysign_4f05

  cmp cx,3EA4
  je handle_xycj_3ea4

  cmp cx,4BB0
  je handle_weekly_4bb0

  cmp cx,4F35
  je handle_jrnt_4f35

  cmp cx,4E61
  je handle_ptask_4e61

  cmp cx,4B49
  je handle_td_4b49

  cmp cx,4B4B
  je handle_td_4b4b

  cmp cx,42A1
  je handle_gf_armyraid

  cmp cx,42A2
  je handle_gf_armyraid

  cmp cx,42A4
  je handle_gf_armyraid

  jmp dispatch_done

handle_gf_armyraid:
  cmp dword ptr [gf_router_callback],00
  je dispatch_done
  mov [gf_router_opcode],ecx
  mov [gf_router_payload],edx
  mov eax,[esp+24]
  mov [gf_router_len],eax
  call dword ptr [gf_router_callback]
  jmp dispatch_done

handle_daysign_4f05:
  mov esi,edx
  call parse_payload

  call dword ptr [Online.exe+1C43DC]
  mov [daysign_last_query],eax
  jmp dispatch_done

handle_xycj_3ea4:
  inc dword ptr [zpdfw_router_3ea4_hits]
  mov esi,edx

  push dword ptr [esi]
  call dword ptr [Online.exe+1C4930]
  mov [xycj_id],eax

  movzx eax,byte ptr [esi+215]
  mov [xycj_count],eax

  movzx eax,byte ptr [esi+21A]
  mov [xycj_state],eax

  mov eax,[Online.exe+230388]
  mov [zpdfw_router_switch_seen],eax
  test eax,eax
  je @f
  mov dword ptr [zpdfw_pending],01
  inc dword ptr [zpdfw_router_pending_sets]
@@:

  mov dword ptr [esp+24],00
  jmp dispatch_done

handle_weekly_4bb0:
  mov esi,edx

  mov eax,[esp+24]
  mov [weekly_recv_len],eax

  // Reconstructed packet bytes:
  // [0..1] = payload_len + 4, [2..3] = 4B B0, [4..] = payload.
  // The original trailing checksum is not available at this dispatch layer.
  mov ebx,eax
  add ebx,04
  mov byte ptr [weekly_packet_dump],bh
  mov byte ptr [weekly_packet_dump+1],bl
  mov byte ptr [weekly_packet_dump+2],4B
  mov byte ptr [weekly_packet_dump+3],B0

  mov ecx,eax
  cmp ecx,07FC
  jbe @f
  mov ecx,07FC
@@:
  lea edi,[weekly_packet_dump+4]
  mov ebx,esi
  test ecx,ecx
  je @f
@@:
  mov al,[ebx]
  mov [edi],al
  inc ebx
  inc edi
  loop @b
@@:

  movzx eax,byte ptr [esi+2]
  shl eax,08
  movzx ebx,byte ptr [esi+3]
  add eax,ebx
  mov [weekly_activity],eax

  push eax
  push router_log_weekly_recv
  push Online.exe+230504
  call Online.exe+2EF0
  add esp,0C

  push 00
  push 00
  push dword ptr [Online.exe+2304D8]
  push dword ptr [Online.exe+2300A4]
  call dword ptr [Online.exe+1C46B0]

  call weekly_find_next_pattern
  cmp dword ptr [weekly_next_data],FFFFFFFF
  je dispatch_done

  mov eax,[weekly_next_data]
  cmp eax,[weekly_last_sent_data]
  jne weekly_new_pair
  jmp dispatch_done

weekly_new_pair:
  mov dword ptr [weekly_pending_next],01
  mov dword ptr [weekly_cmd_send_next],01

  jmp dispatch_done

weekly_find_next_pattern:
  mov dword ptr [weekly_next_data],FFFFFFFF

  mov edi,esi
  mov ecx,[weekly_recv_len]
  cmp ecx,08
  jb weekly_find_next_done
  sub ecx,07

weekly_find_next_loop:
  cmp dword ptr [edi],09007D7B
  je weekly_find_next_found
  inc edi
  loop weekly_find_next_loop
  jmp weekly_find_next_done

weekly_find_next_found:
  mov eax,[edi+4]
  mov [weekly_next_data],eax

weekly_find_next_done:
  ret

handle_jrnt_4f35:
  mov esi,edx
  mov edi,[esp+24]
  cmp edi,04
  jb dispatch_done

  mov dword ptr [jrnt_pending_open],00
  mov byte ptr [jrnt_ids],FF
  mov byte ptr [jrnt_ids+1],FF
  mov byte ptr [jrnt_ids+2],FF
  mov byte ptr [jrnt_claim_pending],00
  mov byte ptr [jrnt_claim_pending+1],00
  mov byte ptr [jrnt_claim_pending+2],00

  movzx eax,byte ptr [esi+3]
  test eax,eax
  je @f
  mov dword ptr [jrnt_pending_open],01
  jmp dispatch_done
@@:

  xor ebx,ebx
  mov ecx,01
jrnt_scan_ids_loop:
  mov eax,edi
  sub eax,02
  cmp ecx,eax
  ja jrnt_scan_ids_done
  cmp byte ptr [esi+ecx],00
  jne jrnt_scan_ids_next
  cmp byte ptr [esi+ecx+1],0C
  jne jrnt_scan_ids_next
  cmp ebx,03
  jae jrnt_scan_ids_next
  mov al,[esi+ecx-1]
  mov [jrnt_ids+ebx],al
  inc ebx
jrnt_scan_ids_next:
  inc ecx
  jmp jrnt_scan_ids_loop

jrnt_scan_ids_done:
  xor ebx,ebx
  mov ecx,01
jrnt_scan_status_loop:
  mov eax,edi
  sub eax,04
  cmp ecx,eax
  ja jrnt_scan_status_done
  cmp byte ptr [esi+ecx],00
  jne jrnt_scan_status_next
  cmp byte ptr [esi+ecx+1],02
  jne jrnt_scan_status_next
  cmp byte ptr [esi+ecx+2],7B
  jne jrnt_scan_status_next
  cmp byte ptr [esi+ecx+3],7D
  jne jrnt_scan_status_next
  cmp ebx,03
  jae jrnt_scan_status_next
  mov al,[esi+ecx-1]
  cmp al,01
  jne @f
  cmp byte ptr [jrnt_ids+ebx],FF
  je @f
  mov byte ptr [jrnt_claim_pending+ebx],01
@@:
  inc ebx
jrnt_scan_status_next:
  inc ecx
  jmp jrnt_scan_status_loop

jrnt_scan_status_done:
  jmp dispatch_done

handle_ptask_4e61:
  mov esi,edx
  mov edi,[esp+24]
  cmp edi,0E
  jb dispatch_done
  cmp dword ptr [ptask_pending_promo],01
  je dispatch_done
  cmp byte ptr [ptask_claim_pending],01
  je dispatch_done
  cmp byte ptr [ptask_claim_pending+1],01
  je dispatch_done
  cmp byte ptr [ptask_claim_pending+2],01
  je dispatch_done

  mov dword ptr [ptask_pending_promo],00
  mov byte ptr [ptask_claim_pending],00
  mov byte ptr [ptask_claim_pending+1],00
  mov byte ptr [ptask_claim_pending+2],00
  mov byte ptr [ptask_reward_ids],00
  mov byte ptr [ptask_reward_ids+1],00
  mov byte ptr [ptask_reward_ids+2],00
  mov byte ptr [ptask_reward_ids+3],00
  mov byte ptr [ptask_reward_ids+4],00
  mov byte ptr [ptask_reward_ids+5],00
  mov byte ptr [ptask_reward_valid],00
  mov byte ptr [ptask_reward_valid+1],00
  mov byte ptr [ptask_reward_valid+2],00

  movzx eax,byte ptr [esi+3]
  mov [ptask_level],eax

  cmp byte ptr [esi+0D],03
  jne ptask_promo_not03
  mov dword ptr [ptask_pending_promo],01
  jmp dispatch_done

ptask_promo_not03:
  xor ebx,ebx
  mov ecx,02
ptask_scan_ids_loop:
  mov eax,edi
  sub eax,04
  cmp ecx,eax
  ja ptask_scan_ids_done
  cmp byte ptr [esi+ecx],00
  jne ptask_scan_ids_next
  cmp byte ptr [esi+ecx+1],14
  jne ptask_scan_ids_next
  cmp ebx,03
  jae ptask_scan_ids_next

  movzx eax,word ptr [esi+ecx+2]
  push ecx
  push ebx
  xor ebp,ebp
  mov edx,02
ptask_id_count_loop:
  mov ebx,edi
  sub ebx,04
  cmp edx,ebx
  ja ptask_id_count_done
  cmp byte ptr [esi+edx],00
  jne ptask_id_count_next
  cmp byte ptr [esi+edx+1],14
  jne ptask_id_count_next
  movzx ecx,word ptr [esi+edx+2]
  cmp ecx,eax
  jne ptask_id_count_next
  inc ebp
ptask_id_count_next:
  inc edx
  jmp ptask_id_count_loop

ptask_id_count_done:
  pop ebx
  pop ecx
  cmp ebp,03
  jb ptask_id_bad_tail

  mov al,[esi+ecx-2]
  mov [ptask_reward_ids+ebx*2],al
  mov al,[esi+ecx-1]
  mov [ptask_reward_ids+ebx*2+1],al
  mov byte ptr [ptask_reward_valid+ebx],01
  inc ebx
  jmp ptask_scan_ids_next

ptask_id_bad_tail:
  jmp ptask_scan_ids_next

ptask_scan_ids_next:
  inc ecx
  jmp ptask_scan_ids_loop

ptask_scan_ids_done:
  xor ebx,ebx
  mov ecx,01
ptask_scan_status_loop:
  mov eax,edi
  sub eax,04
  cmp ecx,eax
  ja ptask_scan_status_done
  cmp byte ptr [esi+ecx],00
  jne ptask_scan_status_next
  cmp byte ptr [esi+ecx+1],03
  jne ptask_scan_status_next
  cmp byte ptr [esi+ecx+2],00
  jne ptask_scan_status_next
  cmp byte ptr [esi+ecx+3],C8
  jne ptask_scan_status_next
  cmp ebx,03
  jae ptask_scan_status_next
  mov al,[esi+ecx-1]
  cmp al,02
  jne ptask_status_after
  cmp byte ptr [ptask_reward_valid+ebx],01
  jne ptask_status_after
  mov byte ptr [ptask_claim_pending+ebx],01
ptask_status_after:
  inc ebx
ptask_scan_status_next:
  inc ecx
  jmp ptask_scan_status_loop

ptask_scan_status_done:
  jmp dispatch_done

td_clear_outputs:
  mov dword ptr [td_parse_error],00
  mov dword ptr [td_fail_stage],00
  mov dword ptr [td_fail_offset],00
  mov dword ptr [td_dbg_task_start],00
  mov dword ptr [td_dbg_after_text],00
  mov dword ptr [td_dbg_after_fixed],00
  mov dword ptr [td_dbg_after_normal],00
  mov dword ptr [td_dbg_after_special],00
  mov dword ptr [td_dbg_after_conditions],00
  mov dword ptr [td_dbg_after_heroes],00
  mov dword ptr [td_dbg_after_extra],00
  mov dword ptr [td_dbg_normal_count],00
  mov dword ptr [td_dbg_special_count],00
  mov dword ptr [td_dbg_condition_count],00
  mov dword ptr [td_dbg_hero_count],00
  mov dword ptr [td_current_dispatch],00
  mov dword ptr [td_max_dispatch],00
  mov dword ptr [td_free_slots],00
  mov dword ptr [td_unassigned_count],00
  mov dword ptr [td_dispatched_count],00
  mov dword ptr [td_unassigned_seen],00
  mov dword ptr [td_dispatched_seen],00
  mov dword ptr [td_claim_pending],00
  mov dword ptr [td_claim_task_id],00
  mov dword ptr [td_claim_task_id+04],00
  mov dword ptr [td_best_pending],00
  mov dword ptr [td_best_task_id],00
  mov dword ptr [td_best_task_id+04],00
  mov dword ptr [td_best_rank],63
  mov dword ptr [td_best_quality],00
  mov dword ptr [td_config_ready],00
  mov dword ptr [td_config_task_id],00
  mov dword ptr [td_config_task_id+04],00
  mov dword ptr [td_4b45_payload_len],00
  mov dword ptr [td_4b45_payload],00
  mov dword ptr [td_4b45_payload+04],00
  mov dword ptr [td_4b45_payload+08],00
  xor ebx,ebx
td_clear_arrays_loop:
  cmp ebx,10
  jae short @f
  mov dword ptr [td_unassigned_ids+ebx*8],00
  mov dword ptr [td_unassigned_ids+ebx*8+04],00
  mov dword ptr [td_unassigned_quality+ebx*4],00
  mov dword ptr [td_unassigned_status+ebx*4],00
  mov dword ptr [td_unassigned_rank+ebx*4],00
  mov dword ptr [td_dispatched_ids+ebx*8],00
  mov dword ptr [td_dispatched_ids+ebx*8+04],00
  mov dword ptr [td_dispatched_quality+ebx*4],00
  mov dword ptr [td_dispatched_status+ebx*4],00
  mov dword ptr [td_dispatched_rank+ebx*4],00
  inc ebx
  jmp td_clear_arrays_loop
@@:
  ret

handle_td_4b49:
  cmp dword ptr [Online.exe+2311F0],00
  je dispatch_done
  call td_clear_outputs
  mov dword ptr [td_parse_error],00
  mov dword ptr [td_fail_stage],00
  mov dword ptr [td_fail_offset],00
  mov esi,edx
  mov edi,edx
  mov [td_payload_base],edx
  mov eax,[esp+24]
  add eax,edx
  mov [td_end],eax

  call td_read_u32_adv
  mov [td_current_dispatch],eax
  call td_read_u32_adv
  mov [td_max_dispatch],eax
  mov edx,eax
  sub edx,[td_current_dispatch]
  mov [td_free_slots],edx
  call td_read_u32_adv
  call td_skip_bytes_eax_1
  call td_read_u32_adv
  call td_read_u16_adv
  cmp dword ptr [td_parse_error],01
  je dispatch_done
  cmp eax,14
  jbe short @f
  mov eax,14
@@:
