[ENABLE]
// AutoLure dash preflow state-machine, AA only.
// No Lua, no timer, no Sleep.
// Hook at sub_4351F0 entry for 100ms dash cadence, plus sub_43B7A0 guard while dash is active.
// Dash state-machine runs before the original auto-function batch. AutoLure sub_43B7A0 is skipped only while dash_action blocks it.
// When all groups finish, original AutoLure is allowed to continue.

alloc(newmem,8192,Online.exe+351F0)
alloc(timerhook,512,Online.exe+403A3)
alloc(dash_groups,512,Online.exe+351F0)
alloc(dashbuf,256,Online.exe+351F0)
alloc(dash_phase,4)
alloc(dash_next_tick,4)
alloc(dash_group_count,4)
alloc(dash_group_index,4)
alloc(dash_action,4)
alloc(dash_target_tmp,4)


label(return_main)
label(return_guard)
label(guardmem)
label(return_timer)
label(run_original_batch)
label(timer_fast)
label(block_original)
label(allow_original)
label(dash_tick)
label(dash_groups_ready)
label(build_groups)
label(bg_done)
label(bg_loop)
label(bg_next)
label(bg_count_ok)
label(find_group)
label(find_group_loop)
label(group_found)
label(create_group)
label(add_payload)
label(add_payload_ok)
label(add_payload_done)
label(get_target)
label(gt_loop)
label(gt_next)
label(gt_fail)
label(send_current_phase)
label(not_due)
label(send_1467)
label(send_373F)
label(send_31E6)
label(send_1483)
label(group_gap)
label(finish_all)
label(send_done_block)
label(send_fail)
label(build_1483_loop)
label(build_1483_done)

newmem:
  pushfd
  pushad
  call dash_tick
  popad
  popfd
  cmp dword ptr [dash_action],1
  je run_original_batch
  ret
run_original_batch:
  push esi
  call Online.exe+38B90
  jmp return_main

guardmem:
  cmp dword ptr [dash_action],1
  je allow_original

block_original:
  ret

allow_original:
  push ebp
  mov ebp,esp
  sub esp,0C
  jmp return_guard

// dash_action: 0 block original, 1 allow original
// dash_phase: 0 idle, 1 send1467, 2 send373F, 3 send31E6, 4 send1483, 5 group gap
// group struct size 64:
// +00 current dword, +04 target dword, +08 count dword, +0C first entry, +10 payload array
dash_tick:
  mov dword ptr [dash_action],0
  cmp dword ptr [dash_phase],0
  jne send_current_phase
  call build_groups
  cmp dword ptr [dash_group_count],0
  jne dash_groups_ready
  mov dword ptr [dash_action],1
  ret

dash_groups_ready:
  jmp send_current_phase

send_current_phase:
  call kernel32.GetTickCount
  cmp eax,[dash_next_tick]
  jb not_due
  mov eax,[dash_group_index]
  cmp eax,[dash_group_count]
  jae finish_all
  shl eax,6
  lea edi,[dash_groups+eax]
  mov eax,[dash_phase]
  cmp eax,1
  je send_1467
  cmp eax,2
  je send_373F
  cmp eax,3
  je send_31E6
  cmp eax,4
  je send_1483
  cmp eax,5
  je group_gap
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_action],1
  ret

not_due:
  ret

send_1467:
  mov ecx,[edi+0C]
  push 0
  push 0
  push 1467
  call Online.exe+4A360
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],2
  ret

send_373F:
  mov ecx,[edi+0C]
  push 0
  push 0
  push 373F
  call Online.exe+4A360
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],3
  ret

send_31E6:
  mov ecx,[edi+0C]
  push 0
  push 0
  push 31E6
  call Online.exe+4A360
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],4
  ret

send_1483:
  mov dword ptr [dashbuf+00],00000000
  mov al,byte ptr [edi+00]
  mov byte ptr [dashbuf+03],al
  mov byte ptr [dashbuf+04],00
  mov al,byte ptr [edi+08]
  mov byte ptr [dashbuf+05],al

  xor ebx,ebx
  lea esi,[edi+10]
  lea edx,[dashbuf+06]
build_1483_loop:
  cmp ebx,[edi+08]
  jge build_1483_done
  mov eax,[esi+00]
  mov [edx+00],eax
  mov eax,[esi+04]
  mov [edx+04],eax
  add esi,8
  add edx,8
  inc ebx
  jmp build_1483_loop
build_1483_done:
  mov dword ptr [edx+00],00000000
  mov al,byte ptr [edi+04]
  mov byte ptr [edx+03],al
  mov eax,[edi+08]
  shl eax,3
  add eax,#10
  mov ecx,[edi+0C]
  push eax
  push dashbuf
  push 1483
  call Online.exe+4A360

  mov eax,[dash_group_index]
  inc eax
  mov [dash_group_index],eax
  cmp eax,[dash_group_count]
  jae finish_all
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],5
  ret

group_gap:
  mov dword ptr [dash_phase],1
  ret

finish_all:
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov dword ptr [dash_action],1
  ret

build_groups:
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov esi,[Online.exe+230644]
  test esi,esi
  je bg_done
  mov ecx,[Online.exe+230648]
  test ecx,ecx
  jle bg_done
  cmp ecx,20
  jle bg_count_ok
  mov ecx,20
bg_count_ok:
  xor ebx,ebx
bg_loop:
  cmp ebx,ecx
  jge bg_done
  mov edi,[esi+ebx*4]
  test edi,edi
  je bg_next
  cmp dword ptr [edi+1C],2
  jne bg_next
  cmp dword ptr [edi+20],3
  jne bg_next
  push ecx
  push esi
  push ebx
  push edi
  call get_target
  cmp eax,FFFFFFFF
  je send_fail
  pop edi
  push edi
  call find_group
  cmp eax,FFFFFFFF
  jne group_found
  call create_group
  cmp eax,FFFFFFFF
  je send_fail
  jmp group_found

group_found:
  mov edx,eax
  call add_payload
  jmp add_payload_done

send_fail:
add_payload_done:
  pop edi
  pop ebx
  pop esi
  pop ecx
bg_next:
  inc ebx
  jmp bg_loop
bg_done:
  cmp dword ptr [dash_group_count],0
  je send_done_block
  mov dword ptr [dash_phase],1
  mov dword ptr [dash_next_tick],0
send_done_block:
  ret

// input: edi=entry, output eax=target dword or FFFFFFFF, edx=current dword
get_target:
  movzx edx,word ptr [edi+30]
  mov eax,[Online.exe+2303EC]
  mov ebp,[Online.exe+2306C4]
  cmp eax,ebp
  jae gt_fail
  mov ebp,[Online.exe+2306C0]
  test ebp,ebp
  je gt_fail
  mov ebp,[ebp+eax*4]
  test ebp,ebp
  je gt_fail
  mov ecx,[ebp+0C]
  test ecx,ecx
  jle gt_fail
  mov ebp,[ebp+08]
  test ebp,ebp
  je gt_fail
  xor eax,eax
gt_loop:
  cmp eax,ecx
  jge gt_fail
  mov esi,[ebp+eax*4]
  test esi,esi
  je gt_next
  cmp dx,[esi]
  jne gt_next
  inc eax
  cmp eax,ecx
  jge gt_fail
  mov esi,[ebp+eax*4]
  test esi,esi
  je gt_fail
  movzx eax,word ptr [esi]
  mov [dash_target_tmp],eax
  ret
gt_next:
  inc eax
  jmp gt_loop
gt_fail:
  mov eax,FFFFFFFF
  ret

// input edi=entry, edx=current. output eax=group ptr or FFFFFFFF
find_group:
  mov eax,[dash_group_count]
  test eax,eax
  jle gt_fail
  xor ecx,ecx
find_group_loop:
  cmp ecx,[dash_group_count]
  jge gt_fail
  mov eax,ecx
  shl eax,6
  lea eax,[dash_groups+eax]
  cmp [eax+00],edx
  je add_payload_ok
  inc ecx
  jmp find_group_loop
add_payload_ok:
  ret

// input edi=entry, edx=current, eax=target still from get_target? no, target lost if after find fail.
// target is stored in [dash_target_tmp]. output eax=group ptr or FFFFFFFF
create_group:
  mov eax,[dash_group_count]
  cmp eax,8
  jae gt_fail
  mov ecx,eax
  shl eax,6
  lea eax,[dash_groups+eax]
  mov [eax+00],edx
  mov edx,[dash_target_tmp]
  mov [eax+04],edx
  mov dword ptr [eax+08],0
  mov [eax+0C],edi
  inc ecx
  mov [dash_group_count],ecx
  ret

// input eax=group ptr, edi=entry
add_payload:
  mov ecx,[eax+08]
  cmp ecx,8
  jae send_fail
  mov edx,ecx
  shl edx,3
  lea edx,[eax+10+edx]
  mov ebp,[edi+00]
  mov [edx+00],ebp
  mov ebp,[edi+04]
  mov [edx+04],ebp
  inc ecx
  mov [eax+08],ecx
  ret

timerhook:
  call Online.exe+351F0
  push 00
  cmp dword ptr [dash_phase],0
  jne timer_fast
  cmp dword ptr [dash_action],0
  je timer_fast
  push 00004E20
  jmp return_timer

timer_fast:
  push #100
  jmp return_timer

Online.exe+351F0:
  jmp newmem
  nop
return_main:

Online.exe+3B7A0:
  jmp guardmem
  nop
return_guard:

Online.exe+403A3:
  jmp timerhook
  nop 7
return_timer:

[DISABLE]
Online.exe+351F0:
  db 56 E8 9A 39 00 00

Online.exe+3B7A0:
  db 55 8B EC 83 EC 0C

Online.exe+403A3:
  db E8 48 4E FF FF 6A 00 68 20 4E 00 00

dealloc(newmem)
dealloc(timerhook)
dealloc(dash_groups)
dealloc(dashbuf)
dealloc(dash_phase)
dealloc(dash_next_tick)
dealloc(dash_group_count)
dealloc(dash_group_index)
dealloc(dash_action)
dealloc(dash_target_tmp)
