label(dash_log_compare_loop)
label(dash_log_emit)
label(dash_log_copy_loop)
label(dash_log_copy_done)
label(dash_log_skip)
label(log_lure_off_fallback_off)
label(log_lure_off_fallback_on)
label(log_lure_on_fallback_off)
label(log_lure_on_fallback_on)
label(str_worldwar)
label(str_blure)
label(str_bfallback)
label(dash_lure_switch)
label(dash_fallback_switch)
label(dash_show_flag)
label(config_read_hits)
label(config_last_bstrike)
label(config_last_lure)
label(config_last_fallback)
label(dash_last_log_text)
newmem:
  pushfd
  pushad
  call dash_tick
  popad
  popfd
  cmp dword ptr [dash_action],1
  je run_original_batch
  ret
run_original_batch:
  push esi
  call Online.exe+38B90
  jmp return_main
guardmem:
  cmp dword ptr [dash_action],1
  je allow_original
block_original:
  ret
allow_original:
  push ebp
  mov ebp,esp
  sub esp,0C
  jmp return_guard
// dash_action: 0 block original, 1 allow original
// dash_phase: 0 idle, 1 send1467, 2 send373F, 3 send31E6, 4 send1483, 5 group gap, 6 check/send1482 fallback
// group struct size 64:
// +00 current dword, +04 target dword, +08 count dword, +0C first entry, +10 payload array
dash_tick:
  call dash_statefix
  mov dword ptr [dash_action],0
  cmp dword ptr [Online.exe+230284],0
  jne dash_total_on
  mov dword ptr [dash_show_flag],0
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_scan_next_tick],0
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov eax,1
  call dash_mark_decision
  mov dword ptr [dash_action],1
  ret
dash_total_on:
  cmp dword ptr [dash_show_flag],0
  je dash_show_options
dash_after_show_options:
  cmp dword ptr [Online.exe+23040C],0
  jne dash_strike_on
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_scan_next_tick],0
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov eax,2
  call dash_mark_decision
  mov dword ptr [dash_action],1
  ret
dash_strike_on:
  cmp dword ptr [dash_lure_switch],0
  jne dash_lure_enabled
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_scan_next_tick],0
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov eax,3
  call dash_mark_decision
  mov dword ptr [dash_action],1
  ret
dash_lure_enabled:
  cmp dword ptr [dash_phase],0
  jne send_current_phase
  call kernel32.GetTickCount
  cmp eax,[dash_scan_next_tick]
  jb allow_original_scan_wait
  call build_groups
  cmp dword ptr [dash_group_count],0
  jne dash_groups_ready
  cmp dword ptr [dash_waiting_no_rush],1
  je allow_original_waiting_no_rush
  cmp dword ptr [dash_has_waiting],1
  je allow_original_waiting_no_rush
  cmp dword ptr [dash_has_move_ready],1
  je allow_original_move_ready
  jmp block_original_ret
  call kernel32.GetTickCount
  add eax,#1000
  mov [dash_scan_next_tick],eax
  jmp allow_original_throttled
allow_original_scan_wait:
  jmp allow_original_throttled
allow_original_throttled:
allow_original_move_ready:
  call kernel32.GetTickCount
  cmp eax,[dash_original_next_tick]
  jb block_original_ret
  add eax,#1000
  mov [dash_original_next_tick],eax
  mov eax,11
  call dash_mark_decision
  mov dword ptr [dash_action],1
  ret
allow_original_waiting_no_rush:
  mov eax,5
  call dash_mark_decision
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_scan_next_tick],0
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov dword ptr [dash_action],1
  ret
block_original_ret:
  mov eax,6
  call dash_mark_decision
  mov dword ptr [dash_action],0
  ret
dash_groups_ready:
  mov eax,7
  call dash_mark_decision
  jmp send_current_phase
send_current_phase:
  mov eax,8
  call dash_mark_decision
  call kernel32.GetTickCount
  cmp eax,[dash_next_tick]
  jb not_due
  mov eax,[dash_group_index]
  cmp eax,[dash_group_count]
  jae finish_all
  shl eax,6
  lea edi,[dash_groups+eax]
  mov eax,[dash_phase]
  cmp eax,1
  je send_1467
  cmp eax,2
  je send_373F
  cmp eax,3
  je send_31E6
  cmp eax,4
  je send_1483
  cmp eax,5
  je group_gap
  cmp eax,6
  je check_1482
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_action],1
  ret
not_due:
  mov eax,9
  call dash_mark_decision
  ret
send_1467:
  mov ecx,[edi+0C]
  push 0
  push 0
  push 1467
  call Online.exe+4A360
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],2
  ret
send_373F:
  mov ecx,[edi+0C]
  push 0
  push 0
  push 373F
  call Online.exe+4A360
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],3
  ret
send_31E6:
  mov ecx,[edi+0C]
  push 0
  push 0
  push 31E6
  call Online.exe+4A360
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],4
  ret
send_1483:
  mov dword ptr [dashbuf+00],00000000
  mov al,byte ptr [edi+00]
  mov byte ptr [dashbuf+03],al
  mov byte ptr [dashbuf+04],00
  mov al,byte ptr [edi+08]
  mov byte ptr [dashbuf+05],al
  xor ebx,ebx
  lea esi,[edi+10]
  lea edx,[dashbuf+06]
build_1483_loop:
  cmp ebx,[edi+08]
  jge build_1483_done
  mov eax,[esi+00]
  mov [edx+00],eax
  mov eax,[esi+04]
  mov [edx+04],eax
  add esi,8
  add edx,8
  inc ebx
  jmp build_1483_loop
build_1483_done:
  mov dword ptr [edx+00],00000000
  mov al,byte ptr [edi+04]
  mov byte ptr [edx+03],al
  mov eax,[edi+08]
  shl eax,3
  add eax,#10
  mov ecx,[edi+0C]
  push eax
  push dashbuf
  push 1483
  call Online.exe+4A360
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],6
  ret
dash_show_options:
  call Online.exe+4D810
  mov dword ptr [dash_show_flag],1
  cmp dword ptr [dash_lure_switch],0
  je dash_show_lure_off_fallback_off
  cmp dword ptr [dash_fallback_switch],0
  je dash_show_lure_on_fallback_off
dash_show_lure_on_fallback_on:
  mov eax,log_lure_on_fallback_on
  call dash_log
  jmp dash_after_show_options
dash_show_lure_on_fallback_off:
  mov eax,log_lure_on_fallback_off
  call dash_log
  jmp dash_after_show_options
dash_show_lure_off_fallback_off:
  cmp dword ptr [dash_fallback_switch],0
  jne dash_show_lure_off_fallback_on
  mov eax,log_lure_off_fallback_off
  call dash_log
  jmp dash_after_show_options
dash_show_lure_off_fallback_on:
  mov eax,log_lure_off_fallback_on
  call dash_log
  jmp dash_after_show_options
check_1482:
  cmp dword ptr [dash_fallback_switch],0
  je advance_group_after_dash
  mov ecx,[edi+0C]
  test ecx,ecx
  je advance_group_after_dash
  movzx eax,word ptr [ecx+30]
  cmp eax,[edi+00]
  jne advance_group_after_dash
  mov eax,[edi+08]
  shl eax,3
  add eax,#10
  push eax
  push dashbuf
  push 1482
  call Online.exe+4A360
advance_group_after_dash:
  mov eax,[dash_group_index]
  inc eax
  mov [dash_group_index],eax
  cmp eax,[dash_group_count]
  jae finish_all
  call kernel32.GetTickCount
  add eax,#100
  mov [dash_next_tick],eax
  mov dword ptr [dash_phase],5
  ret
group_gap:
  mov dword ptr [dash_phase],1
  ret
finish_all:
  mov eax,10
  call dash_mark_decision
  call kernel32.GetTickCount
  add eax,#1000
  mov [dash_scan_next_tick],eax
  mov dword ptr [dash_phase],0
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov dword ptr [Online.exe+230FE0],0
  mov dword ptr [dash_original_next_tick],0
  mov dword ptr [dash_action],1
  ret
dash_statefix:
  inc dword ptr [dash_statefix_tick]
  cmp dword ptr [Online.exe+2303E8],0
  je dash_statefix_done
  mov esi,[Online.exe+230644]
  test esi,esi
  je dash_statefix_done
  mov ecx,[Online.exe+230648]
  test ecx,ecx
  jle dash_statefix_done
  cmp ecx,5
  jle @f
  mov ecx,5
@@:
  xor ebx,ebx

dash_statefix_loop:
  cmp ebx,ecx
  jge dash_statefix_done
  mov edi,[esi+ebx*4]
  test edi,edi
  je dash_statefix_next
  cmp dword ptr [edi+1C],1
  jne dash_statefix_next
  inc dword ptr [dash_statefix_write]
  mov [dash_statefix_last_index],ebx
  mov [dash_statefix_last_entry],edi
  mov dword ptr [edi+1C],4

dash_statefix_next:
  inc ebx
  jmp dash_statefix_loop

dash_statefix_done:
  ret

dash_mark_decision:
  inc dword ptr [dash_decision_count]
  mov [dash_decision_code],eax
  mov ecx,[dash_phase]
  mov [dash_decision_phase],ecx
  mov ecx,[dash_group_count]
  mov [dash_decision_groups],ecx
  mov ecx,[albattle_hero_count]
  mov [dash_decision_hero_count],ecx
  mov ecx,[albattle_left_count]
  mov [dash_decision_left_count],ecx
  mov ecx,[albattle_right_count]
  mov [dash_decision_right_count],ecx
  mov ecx,[albattle_location]
  mov [dash_decision_location],ecx
  ret
build_groups:
  mov dword ptr [dash_group_count],0
  mov dword ptr [dash_group_index],0
  mov dword ptr [dash_waiting_no_rush],0
  mov dword ptr [dash_has_waiting],0
  mov dword ptr [dash_has_move_ready],0
  mov esi,[Online.exe+230644]
  test esi,esi
  je bg_done
  mov ecx,[Online.exe+230648]
  test ecx,ecx
  jle bg_done
  cmp ecx,20
  jle bg_count_ok
  mov ecx,20
bg_count_ok:
  xor ebx,ebx
bg_loop:
  cmp ebx,ecx
  jge bg_done
  mov edi,[esi+ebx*4]
  test edi,edi
  je bg_next
  cmp dword ptr [edi+1C],4
  jne @f
  mov dword ptr [dash_has_move_ready],1
@@:
  cmp dword ptr [edi+1C],2
  jne bg_next
  cmp dword ptr [edi+20],3
  jne bg_next
  mov dword ptr [dash_has_waiting],1
  call dash_rush_count_ok
  cmp eax,01
  je @f
  mov dword ptr [dash_waiting_no_rush],1
  jmp bg_next
@@:
  push ecx
  push esi
  push ebx
  push edi
  call get_target
  cmp eax,FFFFFFFF
  je send_fail
  pop edi
  push edi
  call find_group
  cmp eax,FFFFFFFF
  jne group_found
  call create_group
  cmp eax,FFFFFFFF
  je send_fail
  jmp group_found
group_found:
  mov edx,eax
  call add_payload
  jmp add_payload_done
send_fail:
add_payload_done:
  pop edi
  pop ebx
  pop esi
  pop ecx
bg_next:
  inc ebx
  jmp bg_loop
bg_done:
  cmp dword ptr [dash_group_count],0
  je send_done_block
  mov dword ptr [dash_phase],1
  mov dword ptr [dash_next_tick],0
send_done_block:
  ret
// input: edi=entry, output eax=1 only when 1460 says this hero is waiting and not roleType 4
dash_entry_wait_ok:
  push ebx
  push ecx
  push edx
  push esi
  xor eax,eax
  mov ecx,[albattle_hero_count]
  test ecx,ecx
  jle dash_entry_wait_fail
  cmp ecx,20
  jle short @f
  mov ecx,20
@@:
  xor ebx,ebx
dash_entry_wait_loop:
  cmp ebx,ecx
  jge dash_entry_wait_fail
  mov esi,ebx
  shl esi,4
  mov edx,[edi]
  cmp edx,[albattle_hero_table+esi]
  jne short @f
  mov edx,[edi+04]
  cmp edx,[albattle_hero_table+esi+04]
  jne short @f
  cmp dword ptr [albattle_hero_table+esi+08],01
  je dash_entry_wait_found
@@:
  inc ebx
  jmp dash_entry_wait_loop
dash_entry_wait_found:
  mov eax,01
  jmp short @f
dash_entry_wait_fail:
  xor eax,eax
@@:
  pop esi
  pop edx
  pop ecx
  pop ebx
  ret
// output eax=1 only when current battle side has at least 2x enemy count
dash_rush_count_ok:
  push ebx
  push ecx
  push edx
  mov eax,[albattle_left_count]
  mov [dash_rush_seen_left],eax
  mov ebx,[albattle_right_count]
  mov [dash_rush_seen_right],ebx
  mov ecx,[albattle_location]
  mov [dash_rush_seen_location],ecx
  cmp eax,00
  jne dash_rush_left_nonzero
  cmp ebx,00
  jg dash_rush_compare
  jmp dash_rush_fail

dash_rush_left_nonzero:
  cmp ebx,00
  jle dash_rush_compare
  cmp ecx,00
  je dash_rush_check_left

dash_rush_loc_right:
dash_rush_check_right:
  mov edx,eax
  add edx,eax
  cmp ebx,edx
  jae dash_rush_compare
  jmp dash_rush_fail

dash_rush_check_left:
  mov edx,ebx
  add edx,ebx
  cmp eax,edx
  jae dash_rush_compare
  jmp dash_rush_fail

dash_rush_compare:
dash_rush_success:
  mov dword ptr [dash_rush_seen_result],1
  mov eax,01
  jmp dash_rush_done

dash_rush_fail:
  mov dword ptr [dash_rush_seen_result],0
  xor eax,eax

dash_rush_done:
  pop edx
  pop ecx
  pop ebx
  ret
// input: edi=entry, output eax=target dword or FFFFFFFF, edx=current dword
get_target:
  movzx edx,word ptr [edi+30]
  mov eax,[Online.exe+2303EC]
  mov ebp,[Online.exe+2306C4]
  cmp eax,ebp
  jae gt_fail
  mov ebp,[Online.exe+2306C0]
  test ebp,ebp
  je gt_fail
  mov ebp,[ebp+eax*4]
  test ebp,ebp
  je gt_fail
  mov ecx,[ebp+0C]
  test ecx,ecx
  jle gt_fail
  mov ebp,[ebp+08]
  test ebp,ebp
  je gt_fail
  xor eax,eax
gt_loop:
  cmp eax,ecx
  jge gt_fail
  mov esi,[ebp+eax*4]
  test esi,esi
  je gt_next
  cmp dx,[esi]
  jne gt_next
  inc eax
  cmp eax,ecx
  jge gt_fail
  mov esi,[ebp+eax*4]
  test esi,esi
  je gt_fail
  movzx eax,word ptr [esi]
  mov [dash_target_tmp],eax
  ret
gt_next:
  inc eax
  jmp gt_loop
gt_fail:
  mov eax,FFFFFFFF
  ret
// input edi=entry, edx=current. output eax=group ptr or FFFFFFFF
find_group:
  mov eax,[dash_group_count]
  test eax,eax
  jle gt_fail
  xor ecx,ecx
find_group_loop:
  cmp ecx,[dash_group_count]
  jge gt_fail
  mov eax,ecx
  shl eax,6
  lea eax,[dash_groups+eax]
  cmp [eax+00],edx
  je add_payload_ok
  inc ecx
  jmp find_group_loop
add_payload_ok:
  ret
// input edi=entry, edx=current, eax=target still from get_target? no, target lost if after find fail.
// target is stored in [dash_target_tmp]. output eax=group ptr or FFFFFFFF
create_group:
  mov eax,[dash_group_count]
  cmp eax,8
  jae gt_fail
  mov ecx,eax
  shl eax,6
  lea eax,[dash_groups+eax]
  mov [eax+00],edx
  mov edx,[dash_target_tmp]
  mov [eax+04],edx
  mov dword ptr [eax+08],0
  mov [eax+0C],edi
  inc ecx
  mov [dash_group_count],ecx
  ret
// input eax=group ptr, edi=entry
add_payload:
  mov ecx,[eax+08]
  cmp ecx,8
  jae send_fail
  mov edx,ecx
  shl edx,3
  lea edx,[eax+10+edx]
  mov ebp,[edi+00]
  mov [edx+00],ebp
  mov ebp,[edi+04]
  mov [edx+04],ebp
  inc ecx
  mov [eax+08],ecx
  ret
dash_log:
  ret
  push ebx
  push ecx
  push edx
  push esi
  push edi
  mov ebx,eax
  mov esi,ebx
  mov edi,dash_last_log_text
  mov ecx,#63
dash_log_compare_loop:
  mov dx,[esi]
  cmp dx,[edi]
  jne dash_log_emit
  test dx,dx
  je dash_log_skip
  add esi,2
  add edi,2
  dec ecx
  jne dash_log_compare_loop
dash_log_emit:
  mov esi,ebx
  mov edi,dash_last_log_text
  mov ecx,#63
dash_log_copy_loop:
  mov dx,[esi]
  mov [edi],dx
  test dx,dx
  je dash_log_copy_done
  add esi,2
  add edi,2
  dec ecx
  jne dash_log_copy_loop
  mov word ptr [edi],0
dash_log_copy_done:
  mov eax,ebx
  pop edi
  pop esi
  pop edx
  pop ecx
  pop ebx
  push eax
  push Online.exe+1FE56C
  push Online.exe+230504
  call Online.exe+2EF0
  add esp,0C
  push 00
  push 00
