[ENABLE]
// 2026-06-21 AutoLure dash 100ms LOG TEST copy.
// AutoLure dash preflow state-machine, AA only.
// No Lua, no timer, no Sleep.
// Hook at sub_4351F0 entry for 100ms dash cadence, plus sub_43B7A0 guard while dash is active.
// Dash state-machine runs before the original auto-function batch. AutoLure sub_43B7A0 is skipped only while dash_action blocks it.
// When all groups finish, original AutoLure is allowed to continue.
alloc(newmem,8192,Online.exe+351F0)
alloc(timerhook,512,Online.exe+403A3)
alloc(confighook,1024,Online.exe+4B79B)
alloc(totalonhook,512,Online.exe+401E0)
alloc(resumehook,512,Online.exe+412F0)
alloc(dash_groups,512,Online.exe+351F0)
alloc(dashbuf,256,Online.exe+351F0)
alloc(dash_phase,4)
alloc(dash_next_tick,4)
alloc(dash_scan_next_tick,4)
alloc(dash_original_next_tick,4)
alloc(dash_group_count,4)
alloc(dash_group_index,4)
alloc(dash_action,4)
alloc(dash_has_waiting,4)
alloc(dash_has_move_ready,4)
globalalloc(dash_decision_count,4)
globalalloc(dash_decision_code,4)
globalalloc(dash_decision_phase,4)
globalalloc(dash_decision_groups,4)
globalalloc(dash_decision_hero_count,4)
globalalloc(dash_decision_left_count,4)
globalalloc(dash_decision_right_count,4)
globalalloc(dash_decision_location,4)
globalalloc(dash_statefix_tick,4)
globalalloc(dash_statefix_write,4)
globalalloc(dash_statefix_last_index,4)
globalalloc(dash_statefix_last_entry,4)
globalalloc(dash_rush_seen_left,4)
globalalloc(dash_rush_seen_right,4)
globalalloc(dash_rush_seen_location,4)
globalalloc(dash_rush_seen_result,4)
alloc(dash_waiting_no_rush,4)
alloc(dash_target_tmp,4)
alloc(dash_config,64)
alloc(config_debug,32)
globalalloc(albattle_hero_count,4)
globalalloc(albattle_hero_table,512)
globalalloc(albattle_left_count,4)
globalalloc(albattle_right_count,4)
globalalloc(albattle_location,4)
globalalloc(albattle_rush_ratio,4)
alloc(dash_log_state,128)
label(return_main)
label(return_guard)
label(guardmem)
label(return_timer)
label(return_config)
label(return_total_on)
label(return_resume)
label(run_original_batch)
label(timer_fast)
label(block_original)
label(allow_original)
label(dash_tick)
label(dash_statefix)
label(dash_statefix_loop)
label(dash_statefix_next)
label(dash_statefix_done)
label(dash_mark_decision)
label(dash_total_on)
label(dash_strike_on)
label(dash_show_options)
label(dash_show_lure_off_fallback_off)
label(dash_show_lure_off_fallback_on)
label(dash_show_lure_on_fallback_off)
label(dash_show_lure_on_fallback_on)
label(dash_after_show_options)
label(dash_lure_enabled)
label(allow_original_scan_wait)
label(allow_original_throttled)
label(allow_original_waiting_no_rush)
label(block_original_ret)
label(dash_groups_ready)
label(build_groups)
label(bg_done)
label(bg_loop)
label(bg_next)
label(bg_count_ok)
label(find_group)
label(find_group_loop)
label(group_found)
label(create_group)
label(add_payload)
label(add_payload_ok)
label(add_payload_done)
label(get_target)
label(dash_entry_wait_ok)
label(dash_entry_wait_loop)
label(dash_entry_wait_found)
label(dash_entry_wait_fail)
label(dash_rush_count_ok)
label(dash_rush_loc_right)
label(dash_rush_compare)
label(dash_rush_fail)
label(gt_loop)
label(gt_next)
label(gt_fail)
label(send_current_phase)
